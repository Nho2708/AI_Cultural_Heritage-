# Sao chép thành .env (cùng thư mục với README.md), bỏ dấu # ở dòng cần dùng rồi điền giá trị. Không commit .env.
# Dòng để trống mà không có dấu # sẽ ghi đè giá trị trong %APPDATA%\DSVHVN\ai-service.env, nên chỉ bỏ # ở dòng nào bạn điền.
# Có thể đặt cùng các biến này trong %APPDATA%\DSVHVN\ai-service.env (dùng chung cho mọi bản chạy trên máy).
#ANTHROPIC_API_KEY=
#AI_INTERNAL_KEY=
#AI_MODEL=
# Nhà cung cấp mô hình: anthropic (mặc định, trả theo lượt) hoặc gemini (hạn mức miễn phí của Google AI Studio).
#AI_PROVIDER=gemini
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash
#GEMINI_THINKING_LEVEL=low
