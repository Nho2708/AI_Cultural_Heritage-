<?xml version="1.0" encoding="utf-8"?>
<!--
  Site IIS "DSVHVN AI" trên máy demo (chỉ nghe 127.0.0.1:8090). ASP.NET Core Module chạy Python của .venv ở chế độ
  out-of-process: tự cấp cổng qua ASPNETCORE_PORT (app/serve.py đọc), giữ tiến trình sống và chuyển yêu cầu vào.
  Bí mật không nằm ở đây: dịch vụ đọc C:\dsvhvn\cau-hinh\ai.env qua AI_ENV_FILE.
  requestTimeout dài hơn ngân sách dài nhất của dịch vụ (88 giây cho dịch và tóm tắt di sản).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath=".\.venv\Scripts\python.exe"
                arguments="-m app.serve"
                hostingModel="outofprocess"
                startupTimeLimit="120"
                shutdownTimeLimit="10"
                requestTimeout="00:03:00"
                stdoutLogEnabled="true"
                stdoutLogFile="C:\dsvhvn\nhat-ky\ai">
      <environmentVariables>
        <environmentVariable name="AI_ENV_FILE" value="C:\dsvhvn\cau-hinh\ai.env" />
        <environmentVariable name="PYTHONUTF8" value="1" />
        <environmentVariable name="PYTHONDONTWRITEBYTECODE" value="1" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
